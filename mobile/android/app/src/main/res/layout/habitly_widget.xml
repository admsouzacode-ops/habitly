                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF5F6B63"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/check2"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_check_off"
                android:contentDescription="Marcar como feito"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/plus2"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_plus_bg"
                android:contentDescription="Somar"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#FF1B7A4B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
